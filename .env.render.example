# Examples only. Put actual values in Render's private environment, never GitHub.
APP_NAME="LGU Laoag Project Tracker Pilot"
APP_ENV=production
APP_DEBUG=false
# Render generates this once through render.yaml. Keep it across deployments.
APP_KEY_BASE64=
# APP_URL defaults to Render's HTTPS service URL at startup.
DB_CONNECTION=pgsql
DB_URL=
DB_SSLMODE=require
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
TRACKER_CLOUD=true
TRACKER_MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
TRACKER_BOOTSTRAP_NAME=
TRACKER_BOOTSTRAP_USERNAME=
# Create a new pilot password (12+ characters) in Render; remove after first login.
TRACKER_BOOTSTRAP_PASSWORD=
