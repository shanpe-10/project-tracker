APP_NAME="Laoag City CEO Project Tracker"
APP_ENV="production"
APP_DEBUG="false"
APP_URL="https://laoag-city-ceo-project-tracker.onrender.com"
LOG_CHANNEL="stderr"
LOG_LEVEL="warning"
TRACKER_CLOUD="true"
TRACKER_MEDIA_DISK="s3"
DB_CONNECTION="pgsql"
DB_SSLMODE="require"
SESSION_DRIVER="database"
SESSION_ENCRYPT="true"
SESSION_SECURE_COOKIE="true"
SESSION_SAME_SITE="lax"
SESSION_COOKIE="laoag_ceo_tracker_session"
CACHE_STORE="database"
QUEUE_CONNECTION="sync"
AWS_USE_PATH_STYLE_ENDPOINT="true"
TRACKER_BOOTSTRAP_USERNAME="superadmin"
TRACKER_BOOTSTRAP_NAME="Laoag City CEO Superadmin"
APP_KEY=REPLACE_IN_PRIVATE_RENDER_SETTINGS
DB_URL=REPLACE_IN_PRIVATE_RENDER_SETTINGS
AWS_ACCESS_KEY_ID=REPLACE_IN_PRIVATE_RENDER_SETTINGS
AWS_SECRET_ACCESS_KEY=REPLACE_IN_PRIVATE_RENDER_SETTINGS
AWS_ENDPOINT=REPLACE_IN_PRIVATE_RENDER_SETTINGS
AWS_DEFAULT_REGION=REPLACE_IN_PRIVATE_RENDER_SETTINGS
AWS_BUCKET=REPLACE_IN_PRIVATE_RENDER_SETTINGS
TRACKER_BOOTSTRAP_PASSWORD=REPLACE_IN_PRIVATE_RENDER_SETTINGS
